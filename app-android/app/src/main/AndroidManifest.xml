<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Уведомление сервиса на Android 13+ спрашивается у пользователя;
         без него запись работает, но таймер не виден. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ни одного сетевого разрешения: компаньон никуда не ходит сам.
         Записи уезжают в папку, которую пользователь выбрал руками. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Charoite"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Charoite">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Charoite"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Charoite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
